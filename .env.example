# Copy to .env (cp .env.example .env), then paste your keys after the = signs.
# .env is git-ignored, so your keys are never committed.
ANTHROPIC_API_KEY=
# Used by the 3D character pipeline (meshy.ai, API settings)
MESHY_API_KEY=
# 0 = static characters, no rigging/animation (no Blender needed)
DRAWCOMPANION_ANIMATE=0
# Optional: human-sounding character voices (elevenlabs.io → Developers → API Keys)
ELEVENLABS_API_KEY=
