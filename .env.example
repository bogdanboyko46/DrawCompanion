# DrawCompanion keys. Copy this file to .env (same folder) and fill in.
# .env is ignored by git, so your keys never get committed.
# All DrawCompanion branches read this same file.

# Claude (required for real suggestions): platform.claude.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Meshy (only for the 3D character app on the claude/zealous-meitner-j6qyk8 branch)
MESHY_API_KEY=
